# Copy to .env at the repository root. Never commit real credentials.
# SEC commands use --enable-sec for a one-command opt-in, or SEC_ENABLED=true.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# Required for production/non-loopback binding; send Authorization: Bearer <key>.
# API_KEY=
# Shared per-process request budget; run one worker for this local deployment.
API_REQUESTS_PER_MINUTE=120
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REQUEST_TIMEOUT_SECONDS=20
# Set when PostgreSQL is introduced; credentials belong only in local .env.
# DATABASE_URL=postgresql+psycopg://marketiq:your-password@127.0.0.1:5433/marketiq
# For docker/postgres.compose.yml, use the same generated password as DATABASE_URL:
# POSTGRES_PASSWORD=your-password
# POSTGRES_PORT=5433
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_BATCH_SIZE=32
CHUNK_TOKENS=220
CHUNK_OVERLAP=32
# EMBEDDING_CACHE_PATH=C:/path/to/MarketIQ/data/models

# Phase 5: source evidence works without an LLM. No endpoint is selected automatically.
LLM_PROVIDER=disabled
# Set compatible only after choosing a local or hosted chat-completions endpoint.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=your-installed-model
# LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=512
RAG_TOP_K=6
RAG_RETRIEVAL_MODE=hybrid
# Cosine cutoff for dense candidates only; never applied to BM25 or RRF scores.
RAG_MIN_SCORE=0.3
RAG_MAX_CONTEXT_CHARS=12000
# Provision with: python -m app.research provision-reranker, then enable.
RERANKER_ENABLED=false
RERANKER_BATCH_SIZE=8
# Workflow checkpoints include the question and evidence. Expired jobs are hidden;
# remove them with: python -m app.workflow purge-expired
WORKFLOW_RETENTION_DAYS=7

SEC_ENABLED=false
# Set your actual application/contact before enabling SEC access.
SEC_USER_AGENT=
SEC_REQUESTS_PER_SECOND=5
SEC_POLL_SECONDS=300
SEC_MAX_DOCUMENT_BYTES=50000000
# Optional paths (defaults are absolute paths under the repository's data directory):
# SEC_STATE_PATH=C:/path/to/MarketIQ/data/sec
# RAW_STORAGE_PATH=C:/path/to/MarketIQ/data/raw

MARKET_DATA_PROVIDER=disabled
MARKET_DATA_FEED=iex
# MARKET_API_KEY=
# MARKET_API_SECRET=
MARKET_REQUESTS_PER_MINUTE=200
# delayed_sip requires at least 900; this setting does not grant entitlements.
MARKET_DECLARED_DELAY_SECONDS=0
QUOTE_CACHE_TTL_SECONDS=5
PROVIDER_MAX_RETRIES=4
